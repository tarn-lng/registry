// tarn-protobuf: Protocol Buffers wire format for Tarn, without a schema
// compiler. Writers append tagged fields; decoding walks a cursor over
// borrowed input and returns Copy field descriptors (no stored borrows).
import "string"

pub copy enum Error {
    Truncated
    VarintOverflow
    InvalidWireType
    InvalidFieldNumber
    InvalidUtf8
    WrongWireType
}
/// Wire types: 0 varint, 1 fixed64, 2 length-delimited, 5 fixed32.
pub copy struct Field {
    pub number u32
    pub wire u8
    /// Varint and fixed values; zero for length-delimited fields.
    pub value u64
    /// Payload byte range of a length-delimited field in the decoded input.
    pub start usize
    pub end usize
}

pub struct Writer { data Vec<u8> }
pub fn Writer.new() Writer { return Writer{data: Vec.new()} }
pub fn Writer.len(&self) usize { return self.data.len() }
pub fn Writer.as_slice(&self) &[]u8 { return self.data.as_slice() }
pub fn Writer.finish(self) Vec<u8> { return self.data }
fn Writer._varint(&mut self, value u64) {
    var rest = value
    for rest >= 128 {
        self.data.push(u8(rest & 127) | 128)
        rest = rest >> 7
    }
    self.data.push(u8(rest))
}
fn Writer._tag(&mut self, number u32, wire u8) {
    if number == 0 || number > 536870911 { panic("protobuf field number out of range") }
    self._varint((u64(number) << 3) | u64(wire))
}
pub fn Writer.uint64(&mut self, number u32, value u64) {
    self._tag(number, 0)
    self._varint(value)
}
pub fn Writer.uint32(&mut self, number u32, value u32) { self.uint64(number, u64(value)) }
/// int32/int64 encode negatives as ten-byte two's-complement varints.
pub fn Writer.int64(&mut self, number u32, value i64) { self.uint64(number, _twos(value)) }
pub fn Writer.int32(&mut self, number u32, value i32) { self.uint64(number, _twos(i64(value))) }
pub fn Writer.sint64(&mut self, number u32, value i64) {
    var encoded = u64(0)
    if value >= 0 { encoded = u64(value) * 2 } else { encoded = u64(-(value + 1)) * 2 + 1 }
    self.uint64(number, encoded)
}
pub fn Writer.bool(&mut self, number u32, value bool) {
    if value { self.uint64(number, 1) } else { self.uint64(number, 0) }
}
pub fn Writer.fixed64(&mut self, number u32, value u64) {
    self._tag(number, 1)
    var shift = u64(0)
    for shift < 64 {
        self.data.push(u8((value >> shift) & 255))
        shift = shift + 8
    }
}
pub fn Writer.fixed32(&mut self, number u32, value u32) {
    self._tag(number, 5)
    var shift = u32(0)
    for shift < 32 {
        self.data.push(u8((value >> shift) & 255))
        shift = shift + 8
    }
}
pub fn Writer.bytes(&mut self, number u32, value &[]u8) {
    self._tag(number, 2)
    self._varint(u64(value.len()))
    self.data.extend_from_slice(value)
}
pub fn Writer.string(&mut self, number u32, value &string) { self.bytes(number, value.bytes()) }
pub fn Writer.message(&mut self, number u32, value &Writer) { self.bytes(number, value.as_slice()) }

fn _twos(value i64) u64 {
    if value >= 0 { return u64(value) }
    // Two's complement without overflow: 2^64 - |value|.
    return (u64(-(value + 1)) ^ 18446744073709551615)
}

fn _read_varint(data &[]u8, cursor &mut usize) Result<u64, Error> {
    var result = u64(0)
    var shift = u64(0)
    var count = 0
    for {
        if *cursor >= data.len() { return Err(Error.Truncated) }
        byte := data[*cursor]
        *cursor = *cursor + 1
        count = count + 1
        if count == 10 && byte > 1 { return Err(Error.VarintOverflow) }
        result = result | (u64(byte & 127) << shift)
        if byte < 128 { return Ok(result) }
        shift = shift + 7
    }
}
/// Next field at `cursor`, or None at the end of input. The cursor advances
/// past the whole field, payload included.
pub fn next(data &[]u8, cursor &mut usize) Result<Option<Field>, Error> {
    if *cursor >= data.len() { return Ok(None) }
    key := try _read_varint(data, cursor)
    number := key >> 3
    wire := u8(key & 7)
    if number == 0 || number > 536870911 { return Err(Error.InvalidFieldNumber) }
    var field = Field{number: u32(number), wire: wire, value: 0, start: 0, end: 0}
    if wire == 0 {
        field.value = try _read_varint(data, cursor)
    } else if wire == 1 || wire == 5 {
        var width = usize(8)
        if wire == 5 { width = 4 }
        if data.len() - *cursor < width { return Err(Error.Truncated) }
        var i = usize(0)
        for i < width {
            field.value = field.value | (u64(data[*cursor + i]) << (u64(i) * 8))
            i = i + 1
        }
        *cursor = *cursor + width
    } else if wire == 2 {
        length := try _read_varint(data, cursor)
        if length > u64(data.len() - *cursor) { return Err(Error.Truncated) }
        field.start = *cursor
        field.end = *cursor + usize(length)
        *cursor = field.end
    } else {
        return Err(Error.InvalidWireType)
    }
    return Ok(Some(field))
}

pub fn Field.uint64(&self) Result<u64, Error> {
    if self.wire != 0 { return Err(Error.WrongWireType) }
    return Ok(self.value)
}
pub fn Field.uint32(&self) Result<u32, Error> {
    if self.wire != 0 { return Err(Error.WrongWireType) }
    // proto3 truncates out-of-range uint32 values to their low 32 bits.
    return Ok(u32(self.value & 4294967295))
}
pub fn Field.int64(&self) Result<i64, Error> {
    if self.wire != 0 { return Err(Error.WrongWireType) }
    if self.value < 9223372036854775808 { return Ok(i64(self.value)) }
    return Ok(-i64(self.value ^ 18446744073709551615) - 1)
}
pub fn Field.int32(&self) Result<i32, Error> {
    low := (try self.int64()) & 4294967295
    if low < 2147483648 { return Ok(i32(low)) }
    return Ok(i32(low - 4294967296))
}
pub fn Field.sint64(&self) Result<i64, Error> {
    if self.wire != 0 { return Err(Error.WrongWireType) }
    half := i64(self.value >> 1)
    if (self.value & 1) == 0 { return Ok(half) }
    return Ok(-half - 1)
}
pub fn Field.bool(&self) Result<bool, Error> { return Ok((try self.uint64()) != 0) }
pub fn Field.fixed64(&self) Result<u64, Error> {
    if self.wire != 1 { return Err(Error.WrongWireType) }
    return Ok(self.value)
}
pub fn Field.fixed32(&self) Result<u32, Error> {
    if self.wire != 5 { return Err(Error.WrongWireType) }
    return Ok(u32(self.value))
}
/// Payload of a length-delimited field, borrowed from the decoded input.
pub fn Field.bytes(&self, data &[]u8) Result<&[]u8, Error> {
    if self.wire != 2 { return Err(Error.WrongWireType) }
    return Ok(&data[self.start..self.end])
}
pub fn Field.string(&self, data &[]u8) Result<string, Error> {
    match string.from_utf8(try self.bytes(data)) { Some(text) => { return Ok(text) }
        None => { return Err(Error.InvalidUtf8) } }
}
