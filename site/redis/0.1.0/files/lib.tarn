    packet := format_cmd_3(&"LPUSH", key, value)
    resp := try self.execute(packet)
    match resp {
        RespVal.Integer(n) => return Ok(n)
        _ => return Ok(0)
    }
}

pub fn Client.lpop(&mut self, key &string) Result<Option<string>, Error> {
    packet := format_cmd_2(&"LPOP", key)
    resp := try self.execute(packet)
    match resp {
        RespVal.Bulk(s) => return Ok(Some(s))
        RespVal.Null => return Ok(None)
        _ => return Ok(None)
    }
}

pub fn Client.rpop(&mut self, key &string) Result<Option<string>, Error> {
    packet := format_cmd_2(&"RPOP", key)
    resp := try self.execute(packet)
