import "string"
import "lib"

fn main() {
    print("==================================================")
    print("  Tarn PostgreSQL Native Driver v0.1.0")
    print("  Pure Tarn · Zero C Dependencies · Docker Test")
    print("==================================================")

    db_url := "postgres://postgres:postgres@127.0.0.1:5432/testdb?sslmode=prefer"
    print("Connecting via URL: " + db_url)

    var client: lib.Client
    match lib.Client.connect_url(&db_url) {
        Ok(c) => {
            print("✓ Connection established via connect_url! Protocol 3.0 Handshake OK.")
            client = c
        }
        Err(e) => {
            print("✗ Connection error: " + e.message)
            return
        }
    }

    print("\n[1] Creating 'products' table...")
    drop_sql := "DROP TABLE IF EXISTS products;"
    match client.execute(&drop_sql) {
        Ok(tag) => print("    " + tag)
        Err(e)  => print("    Error: " + e.message)
    }

    create_sql := "CREATE TABLE products (id SERIAL PRIMARY KEY, name TEXT NOT NULL, category TEXT, price NUMERIC(10,2));"
    match client.execute(&create_sql) {
        Ok(tag) => print("    " + tag)
        Err(e)  => print("    Error: " + e.message)
    }

    print("\n[2] Inserting inventory rows...")
    insert_sql := "INSERT INTO products (name, category, price) VALUES ('Mechanical Keyboard', 'Hardware', 129.99), ('27-inch 4K Monitor', 'Hardware', 349.50), ('USB-C Hub', 'Accessories', 39.95), ('Noise Cancelling Headphones', 'Audio', 199.00), ('Desk Pad', 'Accessories', 19.99);"
    match client.execute(&insert_sql) {
        Ok(tag) => print("    " + tag)
        Err(e)  => print("    Error: " + e.message)
    }

    print("\n[3] Querying filtered products (price > 40.00)...")
    select_sql := "SELECT id, name, category, price FROM products WHERE price > 40.00 ORDER BY price DESC;"
    match client.query(&select_sql) {
        Ok(res) => {
            print("    Rows returned: " + string.from_u64(u64(res.rows.len())))
            print("    ------------------------------------------------------")
            for r in res.rows.as_slice() {
                id_val := r.get_or(0, "?")
                name_val := r.get_or(1, "?")
                cat_val := r.get_or(2, "?")
                price_val := r.get_or(3, "?")
                print("    #" + id_val + " | " + name_val + " (" + cat_val + ") - $" + price_val)
            }
            print("    ------------------------------------------------------")
        }
        Err(e) => {
            print("    Query error: " + e.message)
        }
    }

    print("\n[4] Running aggregation query...")
    agg_sql := "SELECT count(*) AS total_count, min(price) AS min_price, max(price) AS max_price FROM products;"
    match client.query(&agg_sql) {
        Ok(res) => {
            if res.rows.len() > usize(0) {
                row := res.rows.get(0)
                count_str := row.get_or(0, "0")
                min_str := row.get_or(1, "0")
                max_str := row.get_or(2, "0")
                print("    Summary: " + count_str + " items | Min: $" + min_str + " | Max: $" + max_str)
            }
        }
        Err(e) => {
            print("    Agg error: " + e.message)
        }
    }

    print("\n[5] Testing Parameterized Query ($1, $2, $3)...")
    insert_param_sql := "INSERT INTO products (name, category, price) VALUES ($1, $2, $3) RETURNING id, name;"
    var ins_params = [3]string{"UltraWide Monitor", "Hardware", "499.99"}
    match client.query_params(&insert_param_sql, &ins_params[..]) {
        Ok(res) => {
            if res.rows.len() > usize(0) {
                row := res.rows.get(0)
                print("    ✓ Inserted via parameters: id=" + row.get_or(0, "?") + ", name=" + row.get_or(1, "?"))
            }
        }
        Err(e) => print("    ✗ Parameterized insert error: " + e.message)
    }

    print("\n[6] Testing SQL Injection immunity via Parameterized Query...")
    // Payload that would dump all products in a string concatenation vulnerability
    inject_sql := "SELECT id, name FROM products WHERE category = $1;"
    var inject_params = [1]string{"Hardware' OR '1'='1"}
    match client.query_params(&inject_sql, &inject_params[..]) {
        Ok(res) => {
            print("    Rows returned with injection payload: " + string.from_u64(u64(res.rows.len())))
            if res.rows.len() == usize(0) {
                print("    ✓ Safe! No records matched the malicious string literal.")
            } else {
                print("    ✗ Potential vulnerability detected!")
            }
        }
        Err(e) => print("    Query error: " + e.message)
    }

    print("\n[7] Closing single client session...")
    match client.close() {
        Ok(_) => print("✓ Session terminated cleanly with Terminate ('X') packet.")
        Err(e) => print("✗ Close error: " + e.message)
    }

    print("\n[8] Testing Connection Pool via Pool.from_url(&url, 5)...")
    var pool_res = lib.Pool.from_url(&db_url, 5)
    match pool_res {
        Ok(p) => {
            var pool = p
            print("    Acquiring client from pool...")
            pool_query_sql := "SELECT count(*) FROM products WHERE category = $1;"
            var cat_params = [1]string{"Hardware"}
            match pool.query_params(&pool_query_sql, &cat_params[..]) {
                Ok(res) => {
                    if res.rows.len() > usize(0) {
                        count_val := res.rows.get(0).get_or(0, "0")
                        print("    ✓ Pool query succeeded! Hardware items count: " + count_val)
                    }
                }
                Err(e) => print("    ✗ Pool query error: " + e.message)
            }
            pool.close()
            print("    ✓ Connection pool closed cleanly.")
        }
        Err(e) => print("    ✗ Pool creation error: " + e.message)
    }

    print("\n[9] Testing URL parser with credentials, port, and query params...")
    test_url := "postgres://alice:secret_pass@db.example.com:5433/production_db?sslmode=require"
    match lib.Config.from_url(&test_url) {
        Ok(parsed_cfg) => {
            print("    ✓ Host: " + parsed_cfg.host + ", Port: " + string.from_u64(u64(parsed_cfg.port)))
            print("    ✓ User: " + parsed_cfg.user + ", Password: " + parsed_cfg.password)
            print("    ✓ Database: " + parsed_cfg.database)
        }
        Err(e) => print("    ✗ URL parse error: " + e.message)
    }

    print("\n==================================================")
    print("  All PostgreSQL operations executed successfully!")
    print("==================================================")
}
